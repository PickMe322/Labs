//в списке нужно поменять слова и цифры

using System;
using System.Collections.Generic;
using System.Linq;
using System.Text;
using System.Threading.Tasks;

namespace Laba_1._1
{
    internal class Program
    {
        static void Main(string[] args)
        {
            List<Trash> trashCollection = new List<Trash>
            {
                new OrganicTrash("Груша", 0.2, 15),
                new MetalTrash("Гвоздь", 0.05, "Сталь"),
                new PlasticTrash("Полиэтиленовый пакет", 0.1, true),
                new ToxicWastes("Ртутный термометр", 0.2, 50),
                new OrganicTrash("Дыня", 0.2, 70),
                new MetalTrash("Алюминиевая банка", 0.08, "Алюминий"),
                new PlasticTrash("Пластиковая упаковка", 0.1, false),
                new ToxicWastes("Просроченные лекарства", 0.15, 11)
            };

            var organicSorter = new TrashSorter<OrganicTrash>();
            var metalSorter = new TrashSorter<MetalTrash>();
            var plasticSorter = new TrashSorter<PlasticTrash>();
            var batterySorter = new TrashSorter<ToxicWastes>();

            var remainingTrash = organicSorter.FilterTrash(trashCollection);
            remainingTrash = metalSorter.FilterTrash(remainingTrash);
            remainingTrash = plasticSorter.FilterTrash(remainingTrash);
            remainingTrash = batterySorter.FilterTrash(remainingTrash);

            Console.WriteLine((organicSorter.DisplayInfo()));
            Console.WriteLine(metalSorter.DisplayInfo());
            Console.WriteLine(plasticSorter.DisplayInfo());
            Console.WriteLine((batterySorter.DisplayInfo()));
        }
    }
}
