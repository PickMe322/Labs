using System;
using System.Collections.Generic;
using System.Linq;
using System.Text;
using System.Threading.Tasks;

namespace Laba_1._1
{
    internal class Trash
    {
        public string Trash_name { get; set; }
        public double Trash_mass { get; set; }
        public Trash(string trash_name, double trash_mass)
        {
            Trash_name = trash_name;
            Trash_mass = trash_mass;
        }
    }
}

using System;
using System.Collections.Generic;
using System.Linq;
using System.Text;
using System.Threading.Tasks;

namespace Laba_1._1
{
    internal class OrganicTrash : Trash
    {
        public int DamagePercent { get; set; }
        public OrganicTrash(string organic_name, double organic_mass, int damage_percentage)
        : base(organic_name, organic_mass)
        {
            DamagePercent = damage_percentage;
        }
    }
}

