//общий сортировщик для любого типа мусора. Содержит методы сортировки и вывода данных

using System;
using System.Collections.Generic;
using System.Linq;
using System.Text;
using System.Threading.Tasks;

namespace Laba_1._1
{
    internal class TrashSorter<T> where T : Trash
    {
        public List<T> sortedTrash = new List<T>();
        public void AddTrash(T trash)
        {
            sortedTrash.Add(trash);
        }

        public List<Trash> FilterTrash(List<Trash> trashCollection)
        {
            List<Trash> remainingTrash = new List<Trash>();

            foreach (var trash in trashCollection)
            {
                if (trash is T ob)
                {
                    AddTrash(ob);
                }
                else
                {
                    remainingTrash.Add(trash);
                }
            }
            return remainingTrash;
        }

        public string DisplayInfo()
        {
            string result = $"\nТип мусора: {typeof(T).Name}:\n";

            foreach (var ob in sortedTrash)
            {
                result += ob.GetInfo() + "\n";

            }
            return result;
        }
    }
}
